<Window
    x:Class="Camera_FOV.UI.LinkedModelsSelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Linked Models"
    Width="412"
    AllowsTransparency="True"
    Background="Transparent"
    SizeToContent="Height"
    TextOptions.TextFormattingMode="Display"
    Topmost="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid
        Margin="16"
        TextElement.FontFamily="{StaticResource Font.Text}"
        TextElement.FontSize="{StaticResource FontSize.Body}"
        TextElement.Foreground="{DynamicResource Text.Primary}">
        <Border Style="{StaticResource Window.Shadow}" />
        <Border Style="{StaticResource Window.Surface}">
            <StackPanel x:Name="ContentRoot">
                <!--  Header (drag to move)  -->
                <Grid
                    Margin="20,20,20,0"
                    Background="Transparent"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="36"
                        Height="36"
                        Margin="0,0,14,0"
                        VerticalAlignment="Top"
                        CornerRadius="9"
                        Style="{StaticResource GlyphTile}">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Text.OnAccent}"
                            Kind="LinkVariant" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Type.Title}" Text="Include linked models?" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource Type.Secondary}"
                            Text="This view shows linked models. Their walls, columns and windows can be traced too, positioned where the link sits in this project." />
                    </StackPanel>
                </Grid>

                <!--  Link list, revealed by "Choose…"  -->
                <Border
                    x:Name="LinksPanel"
                    Margin="20,16,20,0"
                    Style="{StaticResource InsetCard}"
                    Visibility="Collapsed">
                    <ScrollViewer
                        MaxHeight="220"
                        Padding="12,6"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LinksList" AutomationProperties.Name="Linked models">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        MinHeight="32"
                                        HorizontalAlignment="Stretch"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource Input.Check}">
                                        <TextBlock
                                            Style="{StaticResource Type.Body}"
                                            Text="{Binding Name}"
                                            ToolTip="{Binding Name}" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!--  Actions: the recommended choice is on the right and answers Enter; Esc skips  -->
                <StackPanel
                    Margin="20,20,20,20"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        x:Name="BtnNo"
                        Click="BtnNo_Click"
                        Content="Skip links"
                        IsCancel="True"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Trace only this project's elements" />
                    <Button
                        x:Name="BtnSelect"
                        Margin="8,0,0,0"
                        Click="BtnSelect_Click"
                        Content="Choose…"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Pick which linked models to trace" />
                    <Button
                        x:Name="BtnYes"
                        Margin="8,0,0,0"
                        Click="BtnYes_Click"
                        Content="Include all"
                        IsDefault="True"
                        Style="{StaticResource Button.Primary}"
                        ToolTip="Trace this project and every linked model in the view" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
