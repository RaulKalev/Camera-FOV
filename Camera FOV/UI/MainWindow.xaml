<Window
    x:Class="Camera_FOV.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Camera_FOV"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Camera FOV"
    Width="384"
    MinWidth="384"
    AllowsTransparency="True"
    Background="Transparent"
    SizeToContent="Height"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Palette is swapped at runtime by ThemeManager; styles reference it through DynamicResource  -->
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!--  The margin leaves room for the floating window's shadow  -->
    <Grid
        Margin="16"
        TextElement.FontFamily="{StaticResource Font.Text}"
        TextElement.FontSize="{StaticResource FontSize.Body}"
        TextElement.Foreground="{DynamicResource Text.Primary}">
        <Border Style="{StaticResource Window.Shadow}" />
        <Border Style="{StaticResource Window.Surface}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <local:TitleBar />
                    <!--  Window tools, placed just before the title bar's minimize / close buttons  -->
                    <StackPanel
                        Margin="0,0,72,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            x:Name="CheckPointButton"
                            Margin="0,0,2,0"
                            AutomationProperties.Name="Check a point"
                            Click="CheckPointButton_Click"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="Check a point: pick a spot in the plan to see which cameras cover it, and how well">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Kind="Crosshairs" />
                        </Button>
                        <Button
                            x:Name="CameraTypesButton"
                            Margin="0,0,2,0"
                            AutomationProperties.Name="Camera types"
                            Click="CameraTypesButton_Click"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="Camera types: the shared library of camera models, their lenses and field of view ranges, and the Revit types made from them">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Kind="CameraOutline" />
                        </Button>
                        <Button
                            x:Name="CoverageAuditButton"
                            Margin="0,0,2,0"
                            AutomationProperties.Name="Coverage audit"
                            Click="CoverageAuditButton_Click"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="Coverage audit: gaps and overlaps of all cameras in this view, per DORI level">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Kind="MapSearchOutline" />
                        </Button>
                        <Button
                            x:Name="CheckViewCoverageButton"
                            Margin="0,0,2,0"
                            AutomationProperties.Name="Check coverage in this view"
                            Click="CheckViewCoverageButton_Click"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="Check which cameras in this view have coverage that is out of date">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Kind="ClipboardCheckOutline" />
                        </Button>
                        <ToggleButton
                            x:Name="ThemeToggleButton"
                            AutomationProperties.Name="Switch between dark and light appearance"
                            Click="ToggleTheme_Click"
                            IsChecked="True"
                            Style="{StaticResource Toggle.Icon}"
                            ToolTip="Switch between dark and light appearance" />
                        <Button
                            x:Name="SettingsButton"
                            Margin="2,0,0,0"
                            AutomationProperties.Name="Settings"
                            Click="SettingsButton_Click"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="Settings: project setup, draw resolution and parameter names">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Kind="CogOutline" />
                        </Button>
                        <Border
                            Width="1"
                            Height="16"
                            Margin="6,0,4,0"
                            Background="{DynamicResource Separator}" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="ContentRoot" Margin="{StaticResource Pad.Page}">

                    <!--  ============ Camera: current selection is always visible ============  -->
                    <Border Padding="12,10" Style="{StaticResource Card}">
                        <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="32"
                                Height="32"
                                Background="{DynamicResource Surface.Inset}"
                                BorderBrush="{DynamicResource Surface.Stroke}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <materialDesign:PackIcon
                                    x:Name="CameraStatusIcon"
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Text.Tertiary}"
                                    Kind="Cctv" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="10,0,8,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="CameraStatusTitle"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource Type.Body}"
                                    Text="No camera selected" />
                                <TextBlock
                                    x:Name="CameraStatusDetail"
                                    Margin="0,1,0,0"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Pick one in the view"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                            <Button
                                x:Name="SelectElementsButton"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="SelectElementsButton_Click"
                                Content="Select"
                                Style="{StaticResource Button.Small}"
                                ToolTip="Pick a camera (security device) in the active view" />
                        </Grid>

                        <!--  Whether the camera's coverage in this view still matches the camera (issue #9)  -->
                        <Grid
                            x:Name="CoverageStatusRow"
                            Margin="0,10,0,0"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                x:Name="CoverageStatusIcon"
                                Width="16"
                                Height="16"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Kind="InformationOutline" />
                            <TextBlock
                                x:Name="CoverageStatusText"
                                Grid.Column="1"
                                Margin="18,0,8,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Type.Caption}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="UpdateCoverageButton"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="UpdateCoverageButton_Click"
                                Content="Update"
                                Style="{StaticResource Button.Small}"
                                ToolTip="Redraw this camera's coverage from the camera as it is now, for the DORI levels it already has" />
                        </Grid>
                        </StackPanel>
                    </Border>

                    <!--  ============ Camera parameters ============  -->
                    <TextBlock Style="{StaticResource Type.Group}" Text="Camera" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource CardRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Type.Body}" Text="Field of view" />
                                <TextBox
                                    x:Name="FOVAngleTextBox"
                                    Grid.Column="1"
                                    MinWidth="88"
                                    AutomationProperties.Name="Field of view in degrees"
                                    LostFocus="FOVAngleTextBox_LostFocus"
                                    Style="{StaticResource Input.Value}"
                                    Text="93" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource Type.Unit}"
                                    Text="°" />
                            </Grid>
                            <!--  The range allowed by the camera type the selected camera was made from  -->
                            <TextBlock
                                x:Name="FovLimitText"
                                Margin="12,-4,12,8"
                                Style="{StaticResource Type.Caption}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <Border Style="{StaticResource RowSeparator}" />
                            <Grid Style="{StaticResource CardRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Type.Body}" Text="Horizontal resolution" />
                                <ComboBox
                                    x:Name="ResolutionComboBox"
                                    Grid.Column="1"
                                    MinWidth="88"
                                    AutomationProperties.Name="Horizontal resolution in pixels"
                                    Style="{StaticResource Input.Combo}"
                                    ToolTip="Horizontal resolution of the camera sensor">
                                    <ComboBoxItem Content="7424" />
                                    <ComboBoxItem Content="3840" />
                                    <ComboBoxItem Content="3712" />
                                    <ComboBoxItem Content="2880" />
                                    <ComboBoxItem Content="2688" />
                                    <ComboBoxItem Content="2592" />
                                    <ComboBoxItem Content="2560" />
                                    <ComboBoxItem Content="2304" />
                                    <ComboBoxItem Content="1920" />
                                    <ComboBoxItem Content="1280" />
                                    <ComboBoxItem Content="800" />
                                    <ComboBoxItem Content="640" />
                                </ComboBox>
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource Type.Unit}"
                                    Text="px" />
                            </Grid>
                            <Border Style="{StaticResource RowSeparator}" />
                            <Grid Style="{StaticResource CardRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Type.Body}" Text="Max distance" />
                                <!--  Filled in from the DORI level; the value carries its own unit  -->
                                <TextBox
                                    x:Name="MaxDistanceTextBox"
                                    Grid.Column="1"
                                    MinWidth="88"
                                    AutomationProperties.Name="Maximum distance"
                                    Style="{StaticResource Input.Value}"
                                    Text="0"
                                    ToolTip="Range of the widest selected DORI level" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  ============ Rotation ============  -->
                    <TextBlock Style="{StaticResource Type.Group}" Text="Rotation" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource CardRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Type.Body}" Text="Angle" />
                                <Button
                                    x:Name="ToggleRotationSignButton"
                                    Grid.Column="1"
                                    MinWidth="32"
                                    Margin="0,0,6,0"
                                    AutomationProperties.Name="Toggle rotation sign"
                                    Click="ToggleRotationSign_Click"
                                    Content="±"
                                    Style="{StaticResource Button.Small}"
                                    ToolTip="Switch the angle between positive and negative" />
                                <TextBox
                                    x:Name="RotationAngleTextBox"
                                    Grid.Column="2"
                                    MinWidth="88"
                                    AutomationProperties.Name="Rotation angle in degrees"
                                    Style="{StaticResource Input.Value}"
                                    Text="0"
                                    TextChanged="RotationAngleTextBox_TextChanged"
                                    ToolTip="Rotation added to the camera's own orientation, in degrees" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource Type.Unit}"
                                    Text="°" />
                            </Grid>
                            <Border Style="{StaticResource RowSeparator}" />
                            <Grid Style="{StaticResource CardRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Type.Body}" Text="Nudge" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button
                                        x:Name="minusOneDegree"
                                        MinWidth="40"
                                        AutomationProperties.Name="Rotate minus one degree"
                                        Click="MinusOneDegree_Click"
                                        Content="−1°"
                                        Style="{StaticResource Button.Small}" />
                                    <Button
                                        x:Name="plusOneDegree"
                                        MinWidth="40"
                                        Margin="4,0,0,0"
                                        AutomationProperties.Name="Rotate plus one degree"
                                        Click="PlusOneDegree_Click"
                                        Content="+1°"
                                        Style="{StaticResource Button.Small}" />
                                    <Button
                                        x:Name="plusFourFiveDegree"
                                        MinWidth="44"
                                        Margin="4,0,0,0"
                                        AutomationProperties.Name="Rotate plus 45 degrees"
                                        Click="PlusFourFiveDegree_Click"
                                        Content="+45°"
                                        Style="{StaticResource Button.Small}" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource RowSeparator}" />
                            <StackPanel Margin="12,8,12,10">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    Style="{StaticResource Type.Body}"
                                    Text="Quick rotate" />
                                <Border Style="{StaticResource Segmented}">
                                    <UniformGrid Columns="4">
                                        <RadioButton
                                            x:Name="Angle0"
                                            Checked="RotationAngle_Checked"
                                            Content="0°"
                                            GroupName="RotationAngle"
                                            IsChecked="True"
                                            Style="{StaticResource Segment}" />
                                        <RadioButton
                                            x:Name="Angle90"
                                            Checked="RotationAngle_Checked"
                                            Content="90°"
                                            GroupName="RotationAngle"
                                            Style="{StaticResource Segment}" />
                                        <RadioButton
                                            x:Name="Angle180"
                                            Checked="RotationAngle_Checked"
                                            Content="180°"
                                            GroupName="RotationAngle"
                                            Style="{StaticResource Segment}" />
                                        <RadioButton
                                            x:Name="Angle270"
                                            Checked="RotationAngle_Checked"
                                            Content="270°"
                                            GroupName="RotationAngle"
                                            Style="{StaticResource Segment}" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  ============ DORI levels (swatches match the region colours in the plan) ============  -->
                    <TextBlock Style="{StaticResource Type.Group}" Text="DORI coverage" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox
                                x:Name="CheckboxDetection"
                                MinHeight="34"
                                Margin="12,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Detection, 25 pixels per metre"
                                Checked="DORIOption_Checked"
                                IsChecked="False"
                                Style="{StaticResource Input.Check}">
                                <DockPanel>
                                    <TextBlock
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Type.Unit}"
                                        Text="25 px/m" />
                                    <Border Background="{DynamicResource Dori.Detection}" Style="{StaticResource Swatch}" />
                                    <TextBlock Style="{StaticResource Type.Body}" Text="Detection" />
                                </DockPanel>
                            </CheckBox>
                            <Border Style="{StaticResource RowSeparator}" />
                            <CheckBox
                                x:Name="CheckboxObservation"
                                MinHeight="34"
                                Margin="12,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Observation, 63 pixels per metre"
                                Checked="DORIOption_Checked"
                                IsChecked="False"
                                Style="{StaticResource Input.Check}">
                                <DockPanel>
                                    <TextBlock
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Type.Unit}"
                                        Text="63 px/m" />
                                    <Border Background="{DynamicResource Dori.Observation}" Style="{StaticResource Swatch}" />
                                    <TextBlock Style="{StaticResource Type.Body}" Text="Observation" />
                                </DockPanel>
                            </CheckBox>
                            <Border Style="{StaticResource RowSeparator}" />
                            <CheckBox
                                x:Name="CheckboxRecognition"
                                MinHeight="34"
                                Margin="12,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Recognition, 125 pixels per metre"
                                Checked="DORIOption_Checked"
                                IsChecked="False"
                                Style="{StaticResource Input.Check}">
                                <DockPanel>
                                    <TextBlock
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Type.Unit}"
                                        Text="125 px/m" />
                                    <Border Background="{DynamicResource Dori.Recognition}" Style="{StaticResource Swatch}" />
                                    <TextBlock Style="{StaticResource Type.Body}" Text="Recognition" />
                                </DockPanel>
                            </CheckBox>
                            <Border Style="{StaticResource RowSeparator}" />
                            <CheckBox
                                x:Name="CheckboxIdentification"
                                MinHeight="34"
                                Margin="12,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Identification, 250 pixels per metre"
                                Checked="DORIOption_Checked"
                                IsChecked="False"
                                Style="{StaticResource Input.Check}">
                                <DockPanel>
                                    <TextBlock
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Type.Unit}"
                                        Text="250 px/m" />
                                    <Border Background="{DynamicResource Dori.Identification}" Style="{StaticResource Swatch}" />
                                    <TextBlock Style="{StaticResource Type.Body}" Text="Identification" />
                                </DockPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    <TextBlock
                        Margin="12,6,12,0"
                        Style="{StaticResource Type.Caption}"
                        Text="Each selected level is drawn as its own region. Max distance shows the widest one." />

                    <!--  ============ Actions: the task ends here ============  -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="UndoButton"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="Undo last drawn coverage"
                            Click="UndoButton_Click"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="Undo the last drawn coverage">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="Undo" />
                                <TextBlock VerticalAlignment="Center" Text="Undo" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="FilledRegionButton"
                            Grid.Column="1"
                            AutomationProperties.Name="Draw coverage"
                            Click="FilledRegionButton_Click"
                            IsDefault="False"
                            Style="{StaticResource Button.Primary}"
                            ToolTip="Draw a filled region for each selected DORI level">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="VectorPolygon" />
                                <TextBlock VerticalAlignment="Center" Text="Draw coverage" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
