<Window
    x:Class="Camera_FOV.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Camera_FOV"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Settings"
    Width="372"
    AllowsTransparency="True"
    Background="Transparent"
    SizeToContent="Height"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid
        Margin="16"
        TextElement.FontFamily="{StaticResource Font.Text}"
        TextElement.FontSize="{StaticResource FontSize.Body}"
        TextElement.Foreground="{DynamicResource Text.Primary}">
        <Border Style="{StaticResource Window.Shadow}" />
        <Border Style="{StaticResource Window.Surface}">
            <DockPanel>
                <local:TitleBar
                    CanMinimize="False"
                    DockPanel.Dock="Top" />

                <!--  Footer: cancel leaves everything as it was; save applies the parameter names  -->
                <Border
                    Padding="16,12"
                    BorderBrush="{DynamicResource Separator}"
                    BorderThickness="0,1,0,0"
                    DockPanel.Dock="Bottom">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            x:Name="CancelButton"
                            Click="CancelButton_Click"
                            Content="Cancel"
                            IsCancel="True"
                            Style="{StaticResource Button.Secondary}" />
                        <Button
                            x:Name="ApplyButton"
                            MinWidth="80"
                            Margin="8,0,0,0"
                            Click="ApplyButton_Click"
                            Content="Save"
                            IsDefault="True"
                            Style="{StaticResource Button.Primary}" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ContentRoot" Margin="16,0,16,16">

                    <!--  ============ Project setup ============  -->
                    <TextBlock
                        Margin="12,4,0,6"
                        Style="{StaticResource Type.Group}"
                        Text="Project setup" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Button
                                x:Name="ActionButton1"
                                Click="ActionButton1_Click"
                                Style="{StaticResource Button.Row}">
                                <DockPanel>
                                    <Border
                                        Margin="0,0,12,0"
                                        Background="{DynamicResource Accent.Subtle}"
                                        Style="{StaticResource GlyphTile}">
                                        <materialDesign:PackIcon
                                            Width="14"
                                            Height="14"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource Accent.Text}"
                                            Kind="VectorLine" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Type.Body}" Text="Create “Boundary” line style" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Type.Caption}"
                                            Text="Detail lines that block the camera’s view." />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Border Margin="48,0,0,0" Style="{StaticResource RowSeparator}" />
                            <Button
                                x:Name="ActionButton2"
                                Click="ActionButton2_Click"
                                Style="{StaticResource Button.Row}">
                                <DockPanel>
                                    <Border
                                        Margin="0,0,12,0"
                                        Background="{DynamicResource Accent.Subtle}"
                                        Style="{StaticResource GlyphTile}">
                                        <materialDesign:PackIcon
                                            Width="14"
                                            Height="14"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource Accent.Text}"
                                            Kind="VectorPolygon" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Type.Body}" Text="Create DORI region types" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Type.Caption}"
                                            Text="One filled region type per DORI level." />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Border Margin="48,0,0,0" Style="{StaticResource RowSeparator}" />
                            <Button
                                x:Name="ActionButton3"
                                Click="ActionButton3_Click"
                                Style="{StaticResource Button.Row}">
                                <DockPanel>
                                    <Border
                                        Margin="0,0,12,0"
                                        Background="{DynamicResource Accent.Subtle}"
                                        Style="{StaticResource GlyphTile}">
                                        <materialDesign:PackIcon
                                            Width="14"
                                            Height="14"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource Accent.Text}"
                                            Kind="Wall" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Type.Body}" Text="Trace walls" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Type.Caption}"
                                            Text="Draws Boundary lines where walls, columns and windows cross the plan’s cut plane." />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!--  ============ Drawing ============  -->
                    <TextBlock Style="{StaticResource Type.Group}" Text="Drawing" />
                    <Border Padding="12,10,12,10" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Foreground="{DynamicResource Text.Secondary}"
                                    Style="{StaticResource Type.Body}"
                                    Text="{Binding Value, ElementName=ValueSlider, StringFormat={}{0:0.0}°}" />
                                <TextBlock Style="{StaticResource Type.Body}" Text="Region resolution" />
                            </DockPanel>
                            <Slider
                                x:Name="ValueSlider"
                                Margin="-2,8,-2,0"
                                AutomationProperties.Name="Region resolution in degrees"
                                IsSnapToTickEnabled="True"
                                Maximum="1.0"
                                Minimum="0.1"
                                Style="{StaticResource Input.Slider}"
                                TickFrequency="0.1"
                                ValueChanged="ValueSlider_ValueChanged"
                                Value="0.5" />
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Faster" />
                                <TextBlock Style="{StaticResource Type.Caption}" Text="Smoother" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock
                        Margin="12,6,12,0"
                        Style="{StaticResource Type.Caption}"
                        Text="Angle between the rays that trace the coverage outline. Applies to the next drawing." />

                    <!--  ============ Parameter mapping ============  -->
                    <TextBlock Style="{StaticResource Type.Group}" Text="Camera family parameters" />
                    <Border Padding="12,10,12,12" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Instance · Angle" />
                                <TextBlock Style="{StaticResource Type.Body}" Text="Rotation" />
                            </DockPanel>
                            <TextBox
                                x:Name="ParamRotation"
                                AutomationProperties.Name="Rotation parameter name"
                                Style="{StaticResource Input.Text}" />

                            <DockPanel Margin="0,12,0,6">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Instance · Angle" />
                                <TextBlock Style="{StaticResource Type.Body}" Text="FOV override" />
                            </DockPanel>
                            <TextBox
                                x:Name="ParamFOVOverride"
                                AutomationProperties.Name="FOV override parameter name"
                                Style="{StaticResource Input.Text}" />

                            <DockPanel Margin="0,12,0,6">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Instance or type · Angle" />
                                <TextBlock Style="{StaticResource Type.Body}" Text="Standard FOV" />
                            </DockPanel>
                            <TextBox
                                x:Name="ParamStandardFOV"
                                AutomationProperties.Name="Standard FOV parameter name"
                                Style="{StaticResource Input.Text}" />

                            <DockPanel Margin="0,12,0,6">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Instance or type · Text" />
                                <TextBlock Style="{StaticResource Type.Body}" Text="Resolution" />
                            </DockPanel>
                            <TextBox
                                x:Name="ParamResolution"
                                AutomationProperties.Name="Resolution parameter name"
                                Style="{StaticResource Input.Text}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
