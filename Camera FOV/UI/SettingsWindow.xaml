<Window
    x:Class="Camera_FOV.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Camera_FOV"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Settings"
    Width="372"
    AllowsTransparency="True"
    Background="Transparent"
    SizeToContent="Height"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid
        Margin="16"
        TextElement.FontFamily="{StaticResource Font.Text}"
        TextElement.FontSize="{StaticResource FontSize.Body}"
        TextElement.Foreground="{DynamicResource Text.Primary}">
        <Border Style="{StaticResource Window.Shadow}" />
        <Border Style="{StaticResource Window.Surface}">
            <DockPanel>
                <local:TitleBar
                    CanMinimize="False"
                    DockPanel.Dock="Top" />

                <!--  Footer: cancel leaves everything as it was; save applies the parameter names  -->
                <Border
                    Padding="16,12"
                    BorderBrush="{DynamicResource Separator}"
                    BorderThickness="0,1,0,0"
                    DockPanel.Dock="Bottom">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            x:Name="CancelButton"
                            Click="CancelButton_Click"
                            Content="Cancel"
                            IsCancel="True"
                            Style="{StaticResource Button.Secondary}" />
                        <Button
                            x:Name="ApplyButton"
                            MinWidth="80"
                            Margin="8,0,0,0"
                            Click="ApplyButton_Click"
                            Content="Save"
                            IsDefault="True"
                            Style="{StaticResource Button.Primary}" />
                    </StackPanel>
                </Border>

                <ScrollViewer MaxHeight="760" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContentRoot" Margin="16,0,16,16">

                    <!--  ============ Project setup ============  -->
                    <TextBlock
                        Margin="12,4,0,6"
                        Style="{StaticResource Type.Group}"
                        Text="Project setup" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Button
                                x:Name="ActionButton1"
                                Click="ActionButton1_Click"
                                Style="{StaticResource Button.Row}">
                                <DockPanel>
                                    <Border
                                        Margin="0,0,12,0"
                                        Background="{DynamicResource Accent.Subtle}"
                                        Style="{StaticResource GlyphTile}">
                                        <materialDesign:PackIcon
                                            Width="14"
                                            Height="14"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource Accent.Text}"
                                            Kind="VectorLine" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Type.Body}" Text="Create “Boundary” line style" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Type.Caption}"
                                            Text="Detail lines that block the camera’s view." />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Border Margin="48,0,0,0" Style="{StaticResource RowSeparator}" />
                            <Button
                                x:Name="ActionButton2"
                                Click="ActionButton2_Click"
                                Style="{StaticResource Button.Row}">
                                <DockPanel>
                                    <Border
                                        Margin="0,0,12,0"
                                        Background="{DynamicResource Accent.Subtle}"
                                        Style="{StaticResource GlyphTile}">
                                        <materialDesign:PackIcon
                                            Width="14"
                                            Height="14"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource Accent.Text}"
                                            Kind="VectorPolygon" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Type.Body}" Text="Create DORI region types" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Type.Caption}"
                                            Text="One filled region type per DORI level." />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Border Margin="48,0,0,0" Style="{StaticResource RowSeparator}" />
                            <Button
                                x:Name="ActionButton3"
                                Click="ActionButton3_Click"
                                Style="{StaticResource Button.Row}">
                                <DockPanel>
                                    <Border
                                        Margin="0,0,12,0"
                                        Background="{DynamicResource Accent.Subtle}"
                                        Style="{StaticResource GlyphTile}">
                                        <materialDesign:PackIcon
                                            Width="14"
                                            Height="14"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource Accent.Text}"
                                            Kind="Wall" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Type.Body}" Text="Trace walls" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Type.Caption}"
                                            Text="Draws Boundary lines where walls, columns and windows cross the plan’s cut plane." />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!--  ============ Tracing rules (stored in the project) ============  -->
                    <TextBlock Style="{StaticResource Type.Group}" Text="Tracing rules" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="TracingRulesPanel" />
                    </Border>
                    <TextBlock
                        Margin="12,6,12,0"
                        Style="{StaticResource Type.Caption}"
                        TextWrapping="Wrap"
                        Text="Saved in this project and used by Trace walls. A floor plan can’t show what a camera really sees in 3D: open doors and see-through glass only mean no Boundary line is drawn there. Boundary lines you draw yourself are always kept." />

                    <!--  ============ Drawing ============  -->
                    <TextBlock Style="{StaticResource Type.Group}" Text="Drawing" />
                    <Border Padding="12,10,12,10" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Foreground="{DynamicResource Text.Secondary}"
                                    Style="{StaticResource Type.Body}"
                                    Text="{Binding Value, ElementName=ValueSlider, StringFormat={}{0:0.0}°}" />
                                <TextBlock Style="{StaticResource Type.Body}" Text="Region resolution" />
                            </DockPanel>
                            <Slider
                                x:Name="ValueSlider"
                                Margin="-2,8,-2,0"
                                AutomationProperties.Name="Region resolution in degrees"
                                IsSnapToTickEnabled="True"
                                Maximum="1.0"
                                Minimum="0.1"
                                Style="{StaticResource Input.Slider}"
                                TickFrequency="0.1"
                                ValueChanged="ValueSlider_ValueChanged"
                                Value="0.5" />
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Faster" />
                                <TextBlock Style="{StaticResource Type.Caption}" Text="Smoother" />
                            </DockPanel>
                            <CheckBox
                                x:Name="AutoFlipCheckBox"
                                Margin="0,12,0,0"
                                AutomationProperties.Name="Flip the camera symbol to match the coverage"
                                Style="{StaticResource Input.Check}"
                                ToolTip="When drawing, flip the camera family if its 2D symbol points away from the coverage">
                                <TextBlock Style="{StaticResource Type.Body}" Text="Flip camera symbol to match coverage" />
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    <TextBlock
                        Margin="12,6,12,0"
                        Style="{StaticResource Type.Caption}"
                        Text="Angle between the rays that trace the coverage outline. Applies to the next drawing." />

                    <!--  ============ Pixel density ============  -->
                    <TextBlock Style="{StaticResource Type.Group}" Text="Pixel density" />
                    <Border Style="{StaticResource Card}">
                        <Grid Style="{StaticResource CardRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Type.Body}" Text="Formula" />
                            <ComboBox
                                x:Name="FormulaComboBox"
                                Grid.Column="1"
                                MinWidth="150"
                                AutomationProperties.Name="Pixel density formula"
                                Style="{StaticResource Input.Combo}"
                                ToolTip="How pixels per metre and DORI distances are calculated" />
                        </Grid>
                    </Border>
                    <TextBlock
                        Margin="12,6,12,0"
                        Style="{StaticResource Type.Caption}"
                        TextWrapping="Wrap"
                        Text="IEC 62676-4:2026 divides the resolution by the flat scene width, 2 × distance × tan(FOV / 2). Legacy uses the arc length of the view, as Axis Site Designer does, and gives longer distances for wide lenses. Coverage drawn with the other formula is marked out of date. Applies to all projects." />

                    <!--  ============ Angle dimension ============  -->
                    <TextBlock Style="{StaticResource Type.Group}" Text="Angle dimension" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource CardRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Type.Body}" Text="Dimension type" />
                                <ComboBox
                                    x:Name="DimensionTypeComboBox"
                                    Grid.Column="1"
                                    MinWidth="150"
                                    MaxWidth="190"
                                    AutomationProperties.Name="Angular dimension type"
                                    Style="{StaticResource Input.Combo}"
                                    ToolTip="Angular dimension type used for the field of view, or No dimension" />
                            </Grid>
                            <Border Style="{StaticResource RowSeparator}" />
                            <Grid Style="{StaticResource CardRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Type.Body}" Text="Distance from camera" />
                                <TextBox
                                    x:Name="DimensionDistanceTextBox"
                                    Grid.Column="1"
                                    MinWidth="72"
                                    AutomationProperties.Name="Dimension distance from the camera in metres"
                                    Style="{StaticResource Input.Value}"
                                    ToolTip="Radius of the dimension arc, measured from the camera" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource Type.Unit}"
                                    Text="m" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock
                        Margin="12,6,12,0"
                        Style="{StaticResource Type.Caption}"
                        Text="Placed on the innermost DORI region when coverage is drawn. Applies to all projects." />

                    <!--  ============ Parameter mapping ============  -->
                    <TextBlock Style="{StaticResource Type.Group}" Text="Camera family parameters" />
                    <Border Padding="12,10,12,12" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Instance · Angle" />
                                <TextBlock Style="{StaticResource Type.Body}" Text="Rotation" />
                            </DockPanel>
                            <TextBox
                                x:Name="ParamRotation"
                                AutomationProperties.Name="Rotation parameter name"
                                Style="{StaticResource Input.Text}" />

                            <DockPanel Margin="0,12,0,6">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Instance · Angle" />
                                <TextBlock Style="{StaticResource Type.Body}" Text="FOV override" />
                            </DockPanel>
                            <TextBox
                                x:Name="ParamFOVOverride"
                                AutomationProperties.Name="FOV override parameter name"
                                Style="{StaticResource Input.Text}" />

                            <DockPanel Margin="0,12,0,6">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Instance or type · Angle" />
                                <TextBlock Style="{StaticResource Type.Body}" Text="Standard FOV" />
                            </DockPanel>
                            <TextBox
                                x:Name="ParamStandardFOV"
                                AutomationProperties.Name="Standard FOV parameter name"
                                Style="{StaticResource Input.Text}" />

                            <DockPanel Margin="0,12,0,6">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Instance or type · Text" />
                                <TextBlock Style="{StaticResource Type.Body}" Text="Resolution" />
                            </DockPanel>
                            <TextBox
                                x:Name="ParamResolution"
                                AutomationProperties.Name="Resolution parameter name"
                                Style="{StaticResource Input.Text}" />
                            <DockPanel Margin="0,12,0,6">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Instance · Length" />
                                <TextBlock Style="{StaticResource Type.Body}" Text="Mounting height" />
                            </DockPanel>
                            <TextBox
                                x:Name="ParamMountingHeight"
                                AutomationProperties.Name="Mounting height parameter name"
                                Style="{StaticResource Input.Text}"
                                ToolTip="Leave empty to use the camera’s height above its level" />

                            <DockPanel Margin="0,12,0,6">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Instance or type · Angle" />
                                <TextBlock Style="{StaticResource Type.Body}" Text="Tilt (down from horizontal)" />
                            </DockPanel>
                            <TextBox
                                x:Name="ParamTilt"
                                AutomationProperties.Name="Tilt parameter name"
                                Style="{StaticResource Input.Text}" />

                            <DockPanel Margin="0,12,0,6">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Instance · Text" />
                                <TextBlock Style="{StaticResource Type.Body}" Text="Intended observation category" />
                            </DockPanel>
                            <TextBox
                                x:Name="ParamIntendedCategory"
                                AutomationProperties.Name="Intended observation category parameter name"
                                Style="{StaticResource Input.Text}" />

                            <DockPanel Margin="0,12,0,6">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Instance · Text" />
                                <TextBlock Style="{StaticResource Type.Body}" Text="Risk grade" />
                            </DockPanel>
                            <TextBox
                                x:Name="ParamRiskGrade"
                                AutomationProperties.Name="Risk grade parameter name"
                                Style="{StaticResource Input.Text}" />

                            <DockPanel Margin="0,12,0,6">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Instance or type · Number" />
                                <TextBlock Style="{StaticResource Type.Body}" Text="Frame rate" />
                            </DockPanel>
                            <TextBox
                                x:Name="ParamFrameRate"
                                AutomationProperties.Name="Frame rate parameter name"
                                Style="{StaticResource Input.Text}" />

                            <DockPanel Margin="0,12,0,6">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Room or space · Text" />
                                <TextBlock Style="{StaticResource Type.Body}" Text="Required category" />
                            </DockPanel>
                            <TextBox
                                x:Name="ParamRequiredCategory"
                                AutomationProperties.Name="Required category parameter name"
                                Style="{StaticResource Input.Text}"
                                ToolTip="On rooms and spaces: the observation category the area needs, e.g. Validate" />
                        </StackPanel>
                    </Border>

                    <!--  ============ Camera height and tilt (issue #16) ============  -->
                    <TextBlock Style="{StaticResource Type.Group}" Text="Camera height and tilt" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource CardRow}">
                                <CheckBox
                                    x:Name="UseMountingCheckBox"
                                    AutomationProperties.Name="Account for camera height and tilt"
                                    Style="{StaticResource Input.Check}">
                                    <TextBlock Style="{StaticResource Type.Body}" Text="Account for camera height and tilt" />
                                </CheckBox>
                            </Grid>
                            <Border Style="{StaticResource RowSeparator}" />
                            <Grid Style="{StaticResource CardRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Type.Body}" Text="Target height" />
                                <TextBox
                                    x:Name="TargetHeightBox"
                                    Grid.Column="1"
                                    MinWidth="72"
                                    AutomationProperties.Name="Target height in metres"
                                    Style="{StaticResource Input.Value}"
                                    ToolTip="Height of what the camera must see, e.g. a face at 1.6 m or a number plate at 0.5 m" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource Type.Unit}"
                                    Text="m" />
                            </Grid>
                            <Border Style="{StaticResource RowSeparator}" />
                            <Grid Style="{StaticResource CardRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Type.Body}" Text="Steepest view for faces" />
                                <TextBox
                                    x:Name="MaxFaceAngleBox"
                                    Grid.Column="1"
                                    MinWidth="72"
                                    AutomationProperties.Name="Steepest downward view for faces in degrees"
                                    Style="{StaticResource Input.Value}"
                                    ToolTip="A warning is shown when a camera looks down more steeply than this at Identification, Validate or Scrutinise" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource Type.Unit}"
                                    Text="°" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock
                        Margin="12,6,12,0"
                        Style="{StaticResource Type.Caption}"
                        Text="Density is measured from the lens to the target height, and the dead zone under a tilted camera isn’t counted as covered. The drawn DORI regions stay plan-based."
                        TextWrapping="Wrap" />

                    <!--  ============ Moving objects (issue #18) ============  -->
                    <TextBlock Style="{StaticResource Type.Group}" Text="Moving objects" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource CardRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Type.Body}" Text="Walking" />
                                <TextBox x:Name="WalkingBox" Grid.Column="1" MinWidth="72" AutomationProperties.Name="Walking speed in km/h" Style="{StaticResource Input.Value}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Type.Unit}" Text="km/h" />
                            </Grid>
                            <Border Style="{StaticResource RowSeparator}" />
                            <Grid Style="{StaticResource CardRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Type.Body}" Text="Running" />
                                <TextBox x:Name="RunningBox" Grid.Column="1" MinWidth="72" AutomationProperties.Name="Running speed in km/h" Style="{StaticResource Input.Value}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Type.Unit}" Text="km/h" />
                            </Grid>
                            <Border Style="{StaticResource RowSeparator}" />
                            <Grid Style="{StaticResource CardRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Type.Body}" Text="Vehicle" />
                                <TextBox x:Name="VehicleBox" Grid.Column="1" MinWidth="72" AutomationProperties.Name="Vehicle speed in km/h" Style="{StaticResource Input.Value}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Type.Unit}" Text="km/h" />
                            </Grid>
                            <Border Style="{StaticResource RowSeparator}" />
                            <Grid Style="{StaticResource CardRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Type.Body}" Text="Frames needed per crossing" />
                                <TextBox x:Name="MinFramesBox" Grid.Column="1" MinWidth="72" AutomationProperties.Name="Frames needed while an object crosses the view" Style="{StaticResource Input.Value}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock
                        Margin="12,6,12,0"
                        Style="{StaticResource Type.Caption}"
                        Text="Used to count the frames a person or vehicle gets while crossing a camera’s view (IEC 62676-4:2026, 9.2 and Annex D)."
                        TextWrapping="Wrap" />
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
