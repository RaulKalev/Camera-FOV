<Window
    x:Class="Camera_FOV.UI.CameraTypesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Camera_FOV"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Camera types"
    Width="900"
    Height="720"
    MinWidth="720"
    MinHeight="520"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">

    <!--  Resizable from any edge, without a grip; the 16px margin around the surface is the shadow  -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="18"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  A camera type in the list: name over its summary; hover and selection as in the settings rows  -->
            <Style x:Key="TypeItem" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border
                                x:Name="Bd"
                                Margin="0,1"
                                Padding="10,7"
                                Background="Transparent"
                                CornerRadius="{StaticResource Radius.Control}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Row.Hover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent.Subtle}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  A range: two values with a dash between  -->
            <Style
                x:Key="RangeValue"
                BasedOn="{StaticResource Input.Value}"
                TargetType="{x:Type TextBox}">
                <Setter Property="Width" Value="72" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid
        Margin="16"
        TextElement.FontFamily="{StaticResource Font.Text}"
        TextElement.FontSize="{StaticResource FontSize.Body}"
        TextElement.Foreground="{DynamicResource Text.Primary}">
        <Border Style="{StaticResource Window.Shadow}" />
        <Border Style="{StaticResource Window.Surface}">
            <DockPanel x:Name="ContentRoot">
                <local:TitleBar CanMinimize="False" DockPanel.Dock="Top" />

                <!--  Footer: where the library lives, and saving the open type  -->
                <Border
                    Padding="16,12"
                    BorderBrush="{DynamicResource Separator}"
                    BorderThickness="0,1,0,0"
                    DockPanel.Dock="Bottom">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <DockPanel x:Name="LibraryRow" VerticalAlignment="Center">
                            <Button
                                x:Name="ChangeLibraryButton"
                                Margin="8,0,0,0"
                                Click="ChangeLibraryButton_Click"
                                Content="Change"
                                DockPanel.Dock="Right"
                                Style="{StaticResource Button.Small}"
                                ToolTip="Use a shared folder (network drive or synced folder) so everyone works from the same camera types" />
                            <materialDesign:PackIcon
                                x:Name="LibraryIcon"
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Text.Tertiary}"
                                Kind="FolderOutline" />
                            <TextBlock
                                x:Name="LibraryText"
                                TextWrapping="NoWrap"
                                VerticalAlignment="Center"
                                Style="{StaticResource Type.Caption}"
                                TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <DockPanel
                            x:Name="LibraryEditRow"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <Button
                                Margin="6,0,0,0"
                                Click="CancelLibraryButton_Click"
                                Content="Cancel"
                                DockPanel.Dock="Right"
                                Style="{StaticResource Button.Small}" />
                            <Button
                                Margin="6,0,0,0"
                                Click="UseLibraryButton_Click"
                                Content="Use folder"
                                DockPanel.Dock="Right"
                                Style="{StaticResource Button.Small}" />
                            <TextBox
                                x:Name="LibraryFolderBox"
                                Height="{StaticResource Size.ControlSmall}"
                                AutomationProperties.Name="Library folder"
                                Style="{StaticResource Input.Text}"
                                ToolTip="A folder everyone can reach, for example \\server\share\Camera types. Leave empty to keep the library on this PC." />
                        </DockPanel>

                        <StackPanel
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            Orientation="Horizontal">
                            <Button
                                x:Name="RevertButton"
                                Click="RevertButton_Click"
                                Content="Revert"
                                Style="{StaticResource Button.Secondary}"
                                ToolTip="Discard the changes to this camera type" />
                            <Button
                                x:Name="SaveButton"
                                MinWidth="80"
                                Margin="8,0,0,0"
                                Click="SaveButton_Click"
                                Content="Save"
                                Style="{StaticResource Button.Primary}"
                                ToolTip="Save this camera type to the library (Ctrl+S)" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="16,0,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  ============ The library ============  -->
                    <DockPanel>
                        <Grid Margin="0,0,0,8" DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="SearchBox"
                                AutomationProperties.Name="Search camera types"
                                Style="{StaticResource Input.Text}"
                                TextChanged="SearchBox_TextChanged"
                                ToolTip="Search by name, manufacturer or model" />
                            <TextBlock
                                x:Name="SearchHint"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Text.Tertiary}"
                                IsHitTestVisible="False"
                                Style="{StaticResource Type.Body}"
                                Text="Search" />
                            <Button
                                Grid.Column="1"
                                Margin="6,0,0,0"
                                AutomationProperties.Name="Reload the library"
                                Click="ReloadButton_Click"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="Reload the library, to see changes others have saved">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="Refresh" />
                            </Button>
                        </Grid>

                        <UniformGrid
                            Margin="0,8,0,0"
                            Columns="3"
                            DockPanel.Dock="Bottom">
                            <Button
                                Margin="0,0,3,0"
                                Click="NewButton_Click"
                                Content="New"
                                Style="{StaticResource Button.Small}"
                                ToolTip="Add a camera type" />
                            <Button
                                x:Name="DuplicateButton"
                                Margin="3,0"
                                Click="DuplicateButton_Click"
                                Content="Duplicate"
                                Style="{StaticResource Button.Small}"
                                ToolTip="Start a new camera type from this one" />
                            <Button
                                x:Name="DeleteButton"
                                Margin="3,0,0,0"
                                Click="DeleteButton_Click"
                                Content="Delete"
                                Style="{StaticResource Button.Small}"
                                ToolTip="Remove this camera type from the library. Revit types already made from it are kept." />
                        </UniformGrid>

                        <Border Padding="4" Style="{StaticResource InsetCard}">
                            <Grid>
                                <ListBox
                                    x:Name="TypeList"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource TypeItem}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    SelectionChanged="TypeList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Style="{StaticResource Type.Body}"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    Style="{StaticResource Type.Caption}"
                                                    Text="{Binding Summary}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock
                                    x:Name="EmptyListText"
                                    Margin="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Type.Secondary}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </DockPanel>

                    <!--  ============ The open camera type ============  -->
                    <TextBlock
                        x:Name="NoSelectionText"
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource Type.Secondary}"
                        Text="Pick a camera type, or add one with New." />

                    <ScrollViewer
                        x:Name="EditorScroll"
                        Grid.Column="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="EditorPanel" Margin="0,0,6,0">

                            <TextBlock
                                Margin="12,0,0,6"
                                Style="{StaticResource Type.Group}"
                                Text="Camera" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource CardRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Type.Body}" Text="Name" />
                                        <TextBox
                                            x:Name="NameBox"
                                            Grid.Column="1"
                                            Height="{StaticResource Size.ControlSmall}"
                                            AutomationProperties.Name="Camera type name"
                                            Style="{StaticResource Input.Text}"
                                            ToolTip="Also the name of the Revit type made from it" />
                                    </Grid>
                                    <Border Style="{StaticResource RowSeparator}" />
                                    <Grid Style="{StaticResource CardRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Type.Body}" Text="Manufacturer" />
                                        <TextBox
                                            x:Name="ManufacturerBox"
                                            Grid.Column="1"
                                            Height="{StaticResource Size.ControlSmall}"
                                            AutomationProperties.Name="Manufacturer"
                                            Style="{StaticResource Input.Text}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowSeparator}" />
                                    <Grid Style="{StaticResource CardRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Type.Body}" Text="Model" />
                                        <TextBox
                                            x:Name="ModelBox"
                                            Grid.Column="1"
                                            Height="{StaticResource Size.ControlSmall}"
                                            AutomationProperties.Name="Model"
                                            Style="{StaticResource Input.Text}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Type.Group}" Text="Image" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource CardRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Type.Body}" Text="Horizontal resolution" />
                                        <TextBox
                                            x:Name="ResolutionHBox"
                                            Grid.Column="1"
                                            AutomationProperties.Name="Horizontal resolution in pixels"
                                            Style="{StaticResource RangeValue}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{StaticResource Type.Unit}"
                                            Text="px" />
                                    </Grid>
                                    <Border Style="{StaticResource RowSeparator}" />
                                    <Grid Style="{StaticResource CardRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Type.Body}" Text="Vertical resolution" />
                                        <TextBox
                                            x:Name="ResolutionVBox"
                                            Grid.Column="1"
                                            AutomationProperties.Name="Vertical resolution in pixels"
                                            Style="{StaticResource RangeValue}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{StaticResource Type.Unit}"
                                            Text="px" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Type.Group}" Text="Sensor and lens" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource CardRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Type.Body}" Text="Sensor format" />
                                        <ComboBox
                                            x:Name="SensorFormatCombo"
                                            Grid.Column="1"
                                            Width="160"
                                            AutomationProperties.Name="Sensor format"
                                            SelectionChanged="SensorFormatCombo_SelectionChanged"
                                            Style="{StaticResource Input.Combo}"
                                            ToolTip="Sensor widths from IEC 62676-4:2026. The height follows the resolution’s aspect ratio." />
                                    </Grid>
                                    <Border Style="{StaticResource RowSeparator}" />
                                    <Grid Style="{StaticResource CardRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Type.Body}" Text="Sensor width × height" />
                                        <TextBox
                                            x:Name="SensorWidthBox"
                                            Grid.Column="1"
                                            AutomationProperties.Name="Sensor width in millimetres"
                                            Style="{StaticResource RangeValue}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource Type.Unit}"
                                            Text="×" />
                                        <TextBox
                                            x:Name="SensorHeightBox"
                                            Grid.Column="3"
                                            AutomationProperties.Name="Sensor height in millimetres"
                                            Style="{StaticResource RangeValue}" />
                                        <TextBlock
                                            Grid.Column="4"
                                            Style="{StaticResource Type.Unit}"
                                            Text="mm" />
                                    </Grid>
                                    <Border Style="{StaticResource RowSeparator}" />
                                    <Grid Style="{StaticResource CardRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Type.Body}" Text="Focal length" />
                                        <TextBox
                                            x:Name="FocalMinBox"
                                            Grid.Column="1"
                                            AutomationProperties.Name="Shortest focal length in millimetres"
                                            Style="{StaticResource RangeValue}"
                                            ToolTip="Shortest focal length (widest view)" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource Type.Unit}"
                                            Text="–" />
                                        <TextBox
                                            x:Name="FocalMaxBox"
                                            Grid.Column="3"
                                            AutomationProperties.Name="Longest focal length in millimetres"
                                            Style="{StaticResource RangeValue}"
                                            ToolTip="Longest focal length (narrowest view); the same as the shortest for a fixed lens" />
                                        <TextBlock
                                            Grid.Column="4"
                                            Style="{StaticResource Type.Unit}"
                                            Text="mm" />
                                    </Grid>
                                    <Border Style="{StaticResource RowSeparator}" />
                                    <Grid Style="{StaticResource CardRow}">
                                        <Button
                                            x:Name="DeriveFovButton"
                                            HorizontalAlignment="Right"
                                            Click="DeriveFovButton_Click"
                                            Content="Work out field of view"
                                            Style="{StaticResource Button.Small}"
                                            ToolTip="Fill the field of view ranges from the sensor size and focal lengths: 2 × atan(sensor / (2 × focal length))" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Type.Group}" Text="Field of view" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource CardRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Type.Body}" Text="Horizontal" />
                                        <TextBox
                                            x:Name="HFovMinBox"
                                            Grid.Column="1"
                                            AutomationProperties.Name="Narrowest horizontal field of view in degrees"
                                            Style="{StaticResource RangeValue}"
                                            ToolTip="Narrowest horizontal field of view" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource Type.Unit}"
                                            Text="–" />
                                        <TextBox
                                            x:Name="HFovMaxBox"
                                            Grid.Column="3"
                                            AutomationProperties.Name="Widest horizontal field of view in degrees"
                                            Style="{StaticResource RangeValue}"
                                            ToolTip="Widest horizontal field of view; the same as the narrowest for a fixed lens" />
                                        <TextBlock
                                            Grid.Column="4"
                                            Style="{StaticResource Type.Unit}"
                                            Text="°" />
                                    </Grid>
                                    <Border Style="{StaticResource RowSeparator}" />
                                    <Grid Style="{StaticResource CardRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Type.Body}" Text="Vertical" />
                                        <TextBox
                                            x:Name="VFovMinBox"
                                            Grid.Column="1"
                                            AutomationProperties.Name="Narrowest vertical field of view in degrees"
                                            Style="{StaticResource RangeValue}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource Type.Unit}"
                                            Text="–" />
                                        <TextBox
                                            x:Name="VFovMaxBox"
                                            Grid.Column="3"
                                            AutomationProperties.Name="Widest vertical field of view in degrees"
                                            Style="{StaticResource RangeValue}" />
                                        <TextBlock
                                            Grid.Column="4"
                                            Style="{StaticResource Type.Unit}"
                                            Text="°" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock
                                Margin="12,6,12,0"
                                Style="{StaticResource Type.Caption}"
                                Text="For a fixed lens, enter the same value twice. The Camera FOV window keeps a camera of this type within the horizontal range."
                                TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource Type.Group}" Text="Custom parameters" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel x:Name="CustomParametersPanel" />
                                    <Grid Style="{StaticResource CardRow}">
                                        <TextBlock
                                            x:Name="NoCustomParametersText"
                                            Style="{StaticResource Type.Secondary}"
                                            Text="None yet." />
                                        <Button
                                            HorizontalAlignment="Right"
                                            Click="AddParameterButton_Click"
                                            Content="Add parameter"
                                            Style="{StaticResource Button.Small}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock
                                Margin="12,6,12,0"
                                Style="{StaticResource Type.Caption}"
                                Text="Each value is written to the family’s type parameter with the same name. Numbers are read in the units Revit shows, for example 2500 mm or 45°; yes/no as yes or no."
                                TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource Type.Group}" Text="Revit" />
                            <Border Padding="12,10" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Type.Body}"
                                            Text="Family" />
                                        <ComboBox
                                            x:Name="FamilyCombo"
                                            Grid.Column="1"
                                            AutomationProperties.Name="Camera family"
                                            SelectionChanged="FamilyCombo_SelectionChanged"
                                            Style="{StaticResource Input.Combo}"
                                            ToolTip="A camera family loaded in this project (Security Devices)" />
                                        <Button
                                            x:Name="ApplyButton"
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            Click="ApplyButton_Click"
                                            Content="Create Revit type"
                                            Style="{StaticResource Button.Small}" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="LinkedTypesText"
                                        Margin="0,10,0,0"
                                        Style="{StaticResource Type.Secondary}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TextBlock
                                x:Name="WrittenParametersText"
                                Margin="12,6,12,0"
                                Style="{StaticResource Type.Caption}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                x:Name="VersionText"
                                Margin="12,16,12,4"
                                Style="{StaticResource Type.Caption}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
