<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Camera FOV design tokens (theme independent), shared with the Sentinel design system.
        Colours live in DarkTheme / LightTheme.

        Type scale (DIPs)      Caption 11 · Secondary 12 · Body 13 · Emphasis 14 · Section 15 · Title 20
        Spacing scale          2 · 4 · 8 · 12 · 16 · 24   (all margins/paddings come from this scale)
        Radii                  Small 4 · Control 6 · Card 10 · Window 12
        Control height         32 (28 for dense inline controls such as steppers)
    -->

    <!--  Fonts: the platform system font (Segoe UI Variable on Windows 11, Segoe UI on Windows 10)  -->
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>

    <sys:Double x:Key="FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="FontSize.Secondary">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Emphasis">14</sys:Double>
    <sys:Double x:Key="FontSize.Section">15</sys:Double>
    <sys:Double x:Key="FontSize.Title">20</sys:Double>

    <!--  Sizes  -->
    <sys:Double x:Key="Size.Control">32</sys:Double>
    <sys:Double x:Key="Size.ControlSmall">28</sys:Double>
    <sys:Double x:Key="Size.Row">36</sys:Double>
    <sys:Double x:Key="Size.Icon">16</sys:Double>
    <sys:Double x:Key="Size.IconButton">28</sys:Double>

    <!--  Radii  -->
    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Card">10</CornerRadius>
    <CornerRadius x:Key="Radius.Window">12</CornerRadius>

    <!--  Spacing (Thickness helpers on the 4-pt grid)  -->
    <Thickness x:Key="Pad.Control">12,0,12,0</Thickness>
    <Thickness x:Key="Pad.Page">16,4,16,16</Thickness>
    <Thickness x:Key="Pad.CardRow">12,0,12,0</Thickness>

</ResourceDictionary>
