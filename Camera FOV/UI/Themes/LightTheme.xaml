<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Light appearance (Sentinel palette). Soft window grey with white content surfaces, macOS-like accent and
        status hues tuned for text contrast on white.
    -->

    <!--  Window material  -->
    <LinearGradientBrush x:Key="Window.Material" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFF6F6F8" />
        <GradientStop Offset="1" Color="#FFF0F0F3" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Window.Edge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFFFFF" />
        <GradientStop Offset="1" Color="#FFD2D2D7" />
    </LinearGradientBrush>
    <Color x:Key="Shadow.Color">#FF303038</Color>
    <sys:Double x:Key="Shadow.Opacity">0.18</sys:Double>

    <!--  Surfaces  -->
    <SolidColorBrush x:Key="Surface.Raised" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Surface.Inset" Color="#FFF6F6F8" />
    <SolidColorBrush x:Key="Surface.Stroke" Color="#FFDCDCE0" />
    <SolidColorBrush x:Key="Separator" Color="#FFE6E6EA" />

    <!--  Controls  -->
    <SolidColorBrush x:Key="Control.Fill" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Control.FillHover" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="Control.FillPressed" Color="#FFE6E6EB" />
    <SolidColorBrush x:Key="Control.Stroke" Color="#FFC8C8CE" />
    <SolidColorBrush x:Key="Control.Plain.Hover" Color="#0F000000" />
    <SolidColorBrush x:Key="Control.Plain.Pressed" Color="#1C000000" />
    <SolidColorBrush x:Key="Input.Fill" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Input.Stroke" Color="#FFC5C5CB" />
    <SolidColorBrush x:Key="Input.StrokeHover" Color="#FF9E9EA6" />
    <SolidColorBrush x:Key="Slider.Track" Color="#FFD8D8DD" />
    <SolidColorBrush x:Key="Slider.Thumb" Color="#FFFFFFFF" />

    <!--  Text  -->
    <SolidColorBrush x:Key="Text.Primary" Color="#FF1D1D1F" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#FF5F5F66" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#FF8A8A91" />
    <SolidColorBrush x:Key="Text.Disabled" Color="#FFB3B3B9" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFFFF" />

    <!--  Accent + focus  -->
    <SolidColorBrush x:Key="Accent" Color="#FF007AFF" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#FF1A88FF" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="#FF0062CC" />
    <SolidColorBrush x:Key="Accent.Subtle" Color="#1F007AFF" />
    <SolidColorBrush x:Key="Accent.Text" Color="#FF0063CC" />
    <SolidColorBrush x:Key="Focus.Ring" Color="#FF007AFF" />

    <!--  Status  -->
    <SolidColorBrush x:Key="Status.Warning" Color="#FFC93400" />
    <SolidColorBrush x:Key="Status.WarningSubtle" Color="#26FF9500" />
    <SolidColorBrush x:Key="Status.Error" Color="#FFD70015" />
    <SolidColorBrush x:Key="Status.ErrorSubtle" Color="#1FFF3B30" />
    <SolidColorBrush x:Key="Status.Success" Color="#FF248A3D" />
    <SolidColorBrush x:Key="Status.SuccessSubtle" Color="#2634C759" />

    <!--
        DORI swatches: the same hues as the filled region types the plugin creates (red, yellow, blue,
        green), in a pastel strong enough to read on the panel. The region fills in the plan stay pale.
    -->
    <SolidColorBrush x:Key="Dori.Detection" Color="#FFF08A83" />
    <SolidColorBrush x:Key="Dori.Observation" Color="#FFF4CB4E" />
    <SolidColorBrush x:Key="Dori.Recognition" Color="#FF7FAEF3" />
    <SolidColorBrush x:Key="Dori.Identification" Color="#FF72BF8A" />

    <!--  Lists  -->
    <SolidColorBrush x:Key="Row.Hover" Color="#0D000000" />

</ResourceDictionary>
