<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Dark appearance (Sentinel palette). Neutral graphite greys with a slight cool cast, macOS-like system accent
        and status hues. The window is a single floating material: a soft gradient with a bright top edge, which
        approximates vibrancy – WPF layered windows cannot blur what is behind them.
    -->

    <!--  Window material  -->
    <LinearGradientBrush x:Key="Window.Material" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF242427" />
        <GradientStop Offset="1" Color="#FF1E1E20" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Window.Edge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#38FFFFFF" />
        <GradientStop Offset="0.4" Color="#14FFFFFF" />
        <GradientStop Offset="1" Color="#0FFFFFFF" />
    </LinearGradientBrush>
    <Color x:Key="Shadow.Color">#FF000000</Color>
    <sys:Double x:Key="Shadow.Opacity">0.45</sys:Double>

    <!--  Surfaces  -->
    <SolidColorBrush x:Key="Surface.Raised" Color="#FF2C2C2F" />
    <SolidColorBrush x:Key="Surface.Inset" Color="#FF202023" />
    <SolidColorBrush x:Key="Surface.Stroke" Color="#FF38383C" />
    <SolidColorBrush x:Key="Separator" Color="#FF333337" />

    <!--  Controls  -->
    <SolidColorBrush x:Key="Control.Fill" Color="#FF3A3A3E" />
    <SolidColorBrush x:Key="Control.FillHover" Color="#FF444449" />
    <SolidColorBrush x:Key="Control.FillPressed" Color="#FF2F2F33" />
    <SolidColorBrush x:Key="Control.Stroke" Color="#FF4A4A4F" />
    <SolidColorBrush x:Key="Control.Plain.Hover" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Control.Plain.Pressed" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="Input.Fill" Color="#FF1C1C1F" />
    <SolidColorBrush x:Key="Input.Stroke" Color="#FF46464B" />
    <SolidColorBrush x:Key="Input.StrokeHover" Color="#FF5A5A60" />
    <SolidColorBrush x:Key="Slider.Track" Color="#FF46464B" />
    <SolidColorBrush x:Key="Slider.Thumb" Color="#FFF2F2F5" />

    <!--  Text  -->
    <SolidColorBrush x:Key="Text.Primary" Color="#FFF2F2F5" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFA8A8B0" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#FF7C7C84" />
    <SolidColorBrush x:Key="Text.Disabled" Color="#FF5E5E64" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFFFF" />

    <!--  Accent + focus  -->
    <SolidColorBrush x:Key="Accent" Color="#FF0A84FF" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#FF3395FF" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="#FF0068CC" />
    <SolidColorBrush x:Key="Accent.Subtle" Color="#330A84FF" />
    <SolidColorBrush x:Key="Accent.Text" Color="#FF4DA3FF" />
    <SolidColorBrush x:Key="Focus.Ring" Color="#FF4DA3FF" />

    <!--  Status  -->
    <SolidColorBrush x:Key="Status.Warning" Color="#FFFF9F0A" />
    <SolidColorBrush x:Key="Status.WarningSubtle" Color="#33FF9F0A" />
    <SolidColorBrush x:Key="Status.Error" Color="#FFFF6961" />
    <SolidColorBrush x:Key="Status.ErrorSubtle" Color="#33FF453A" />
    <SolidColorBrush x:Key="Status.Success" Color="#FF32D74B" />
    <SolidColorBrush x:Key="Status.SuccessSubtle" Color="#3332D74B" />

    <!--
        DORI swatches: the same hues as the filled region types the plugin creates (red, yellow, blue,
        green), in a pastel strong enough to read on the panel. The region fills in the plan stay pale.
    -->
    <SolidColorBrush x:Key="Dori.Detection" Color="#FFF28B82" />
    <SolidColorBrush x:Key="Dori.Observation" Color="#FFFDD663" />
    <SolidColorBrush x:Key="Dori.Recognition" Color="#FF8AB4F8" />
    <SolidColorBrush x:Key="Dori.Identification" Color="#FF81C995" />

    <!--  Lists  -->
    <SolidColorBrush x:Key="Row.Hover" Color="#12FFFFFF" />

</ResourceDictionary>
