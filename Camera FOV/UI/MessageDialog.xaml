<Window
    x:Class="Camera_FOV.UI.MessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Camera FOV"
    Width="412"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    SizeToContent="Height"
    TextOptions.TextFormattingMode="Display"
    Topmost="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid
        Margin="16"
        TextElement.FontFamily="{StaticResource Font.Text}"
        TextElement.FontSize="{StaticResource FontSize.Body}"
        TextElement.Foreground="{DynamicResource Text.Primary}">
        <Border Style="{StaticResource Window.Shadow}" />
        <Border Style="{StaticResource Window.Surface}">
            <StackPanel x:Name="ContentRoot">
                <!--  Header (drag to move); the tile colour and glyph follow the dialog kind  -->
                <Grid
                    Margin="20,20,20,0"
                    Background="Transparent"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="KindTile"
                        Width="36"
                        Height="36"
                        Margin="0,0,14,0"
                        VerticalAlignment="Top"
                        CornerRadius="9">
                        <materialDesign:PackIcon
                            x:Name="KindIcon"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            x:Name="HeadingText"
                            Style="{StaticResource Type.Title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="MessageText"
                            Margin="0,4,0,0"
                            Style="{StaticResource Type.Secondary}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!--  One row per item: what it is and what it means or how to fix it  -->
                <Border
                    x:Name="ItemsPanel"
                    Margin="20,16,20,0"
                    Style="{StaticResource InsetCard}"
                    Visibility="Collapsed">
                    <ItemsControl x:Name="ItemsList" Margin="0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="12,6">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Style="{StaticResource Type.Body}"
                                        Text="{Binding Label}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Style="{StaticResource Type.Secondary}"
                                        Text="{Binding Detail}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!--  Technical details (exception text), revealed on request and selectable for copying  -->
                <Border
                    x:Name="DetailsPanel"
                    Margin="20,16,20,0"
                    Style="{StaticResource InsetCard}"
                    Visibility="Collapsed">
                    <TextBox
                        x:Name="DetailsText"
                        MaxHeight="160"
                        Padding="10,8"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="{DynamicResource Text.Secondary}"
                        HorizontalScrollBarVisibility="Disabled"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </Border>

                <Grid Margin="20">
                    <Button
                        x:Name="DetailsButton"
                        HorizontalAlignment="Left"
                        Click="DetailsButton_Click"
                        Content="Show details"
                        Style="{StaticResource Button.Secondary}"
                        Visibility="Collapsed" />
                    <Button
                        MinWidth="72"
                        HorizontalAlignment="Right"
                        Click="OkButton_Click"
                        Content="OK"
                        IsCancel="True"
                        IsDefault="True"
                        Style="{StaticResource Button.Primary}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
